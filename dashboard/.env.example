# Same-origin /api proxy is the default. Leave NEXT_PUBLIC_API_URL unset.
SHOPAWARE_BACKEND_URL=http://127.0.0.1:8000

# WebSocket behavior:
# - localhost development defaults to ws://<host>:8000/ws
# - non-localhost deployments default to same-origin /ws (recommended behind TLS proxy)
# Set NEXT_PUBLIC_WS_URL only when you intentionally need an explicit public WS URL.
