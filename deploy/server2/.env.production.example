# ShopAware server2 production example
# Copy to /opt/shopaware/.env and edit before first start.

SHOPAWARE_DETECTION_MODEL=yolo26n.pt
SHOPAWARE_POSE_MODEL=yolo26n-pose.pt
SHOPAWARE_SPECIALIZED_MODEL=shoplifting.pt
# Keep false unless you intentionally install and qualify a specialized checkpoint.
SHOPAWARE_ENABLE_SPECIALIZED_MODEL=false

SHOPAWARE_API_HOST=0.0.0.0
SHOPAWARE_API_PORT=8000
SHOPAWARE_DB_PATH=/app/data/shopaware.db
SHOPAWARE_KEY_FILE=/app/data/.shopaware.key
SHOPAWARE_ALERT_DIR=/app/alerts
SHOPAWARE_INCIDENT_DIR=/app/incidents
YOLO_CONFIG_DIR=/app/data/ultralytics

SHOPAWARE_CORS_ORIGINS=https://shopaware.innawareucp.com
SHOPAWARE_COOKIE_SECURE=true

# Runtime/detection tuning. Start conservatively and tune from real footage.
SHOPAWARE_ALERT_COOLDOWN=8
SHOPAWARE_LOITERING_THRESHOLD=12
SHOPAWARE_OBJECT_INFERENCE_EVERY_N_FRAMES=5
SHOPAWARE_JPEG_QUALITY=65
SHOPAWARE_INFERENCE_FPS=5
SHOPAWARE_RISK_THRESHOLD=65

# Evidence/retention
SHOPAWARE_PRE_EVENT_SECONDS=15
SHOPAWARE_POST_EVENT_SECONDS=30
SHOPAWARE_RECORDING_FPS=6
SHOPAWARE_RECORDING_JPEG_QUALITY=72
SHOPAWARE_RETENTION_DAYS=30
SHOPAWARE_MAX_STORAGE_BYTES=10737418240

# SMTP can also be configured in the authenticated Settings UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# CPU image is the default. For a compatible NVIDIA deployment set this to the
# PyTorch wheel index appropriate for the installed driver/CUDA environment.
SHOPAWARE_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
