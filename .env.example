# ShopAware runtime
SHOPAWARE_DETECTION_MODEL=yolo26n.pt
SHOPAWARE_POSE_MODEL=yolo26n-pose.pt
SHOPAWARE_SPECIALIZED_MODEL=shoplifting.pt
SHOPAWARE_ENABLE_SPECIALIZED_MODEL=true
SHOPAWARE_API_HOST=0.0.0.0
SHOPAWARE_API_PORT=8000
SHOPAWARE_ALERT_DIR=alerts
SHOPAWARE_INCIDENT_DIR=incidents
SHOPAWARE_DB_PATH=shopaware.db
SHOPAWARE_KEY_FILE=.shopaware.key
SHOPAWARE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Detection/runtime tuning
SHOPAWARE_ALERT_COOLDOWN=8
SHOPAWARE_LOITERING_THRESHOLD=12
SHOPAWARE_OBJECT_INFERENCE_EVERY_N_FRAMES=5
SHOPAWARE_JPEG_QUALITY=65
SHOPAWARE_INFERENCE_FPS=5

# Incident evidence recording
SHOPAWARE_PRE_EVENT_SECONDS=15
SHOPAWARE_POST_EVENT_SECONDS=30
SHOPAWARE_RECORDING_FPS=6
SHOPAWARE_RECORDING_JPEG_QUALITY=72

# Alerting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional Telegram compatibility inherited from upstream
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
