# ShopAware runtime
SHOPAWARE_DETECTION_MODEL=yolo26n.pt
SHOPAWARE_POSE_MODEL=yolo26n-pose.pt
SHOPAWARE_SPECIALIZED_MODEL=shoplifting.pt
SHOPAWARE_ENABLE_SPECIALIZED_MODEL=true
SHOPAWARE_API_HOST=0.0.0.0
SHOPAWARE_API_PORT=8000
SHOPAWARE_ALERT_DIR=alerts
SHOPAWARE_DB_PATH=shopaware.db

# Alerting
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Optional Telegram compatibility inherited from upstream
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
